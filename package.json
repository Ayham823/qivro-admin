{
  "name": "qivro-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "lint": "npm run lint:eslint && npm run check:architecture",
    "lint:eslint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.52.0",
    "lucide-react": "^1.7.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.8"
  }
}
